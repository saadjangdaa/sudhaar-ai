# ---------------------------------------------------------------------------
# api/.env  — copy to .env and fill in. Never commit the real file.
# ---------------------------------------------------------------------------

# --- Gemini (the only model provider in this project) ---
# Get a key from https://aistudio.google.com/apikey
# One model does text, vision and voice-note transcription, so there is no
# separate transcription model.
#
# Pin a concrete model. gemini-flash-latest is an alias that returns 503 under
# load, and the 2.x flash models are retired. flash-lite is the default because
# the free tier meters requests per day PER MODEL, and gemini-3.6-flash allows
# only 20 of them -- a single report costs four calls.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# --- Supabase: SERVICE ROLE key, server-side only. Bypasses RLS. ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- behaviour ---
# true  = every agent returns canned output, zero API spend (what stage 0 ships)
# false = real Gemini calls
MOCK_AGENTS=true

# Comma-separated. Add each developer localhost and the Vercel domain.
ALLOWED_ORIGINS=http://localhost:3000

# Used to build the "view this complaint online" link in the email body.
# localhost while developing, the Vercel URL once deployed.
WEB_BASE_URL=http://localhost:3000

# --- email: OFF by default ---
ENABLE_EMAIL=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
# Gmail 16-character app password, NOT the account password. Requires 2FA.
SMTP_APP_PASSWORD=
SMTP_FROM_NAME=Sudhaar AI
# SAFETY VALVE: all mail goes here instead of the authority address.
# The seeded authority emails are invented placeholders. Keep this set.
EMAIL_OVERRIDE_TO=
