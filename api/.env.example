# ---------------------------------------------------------------------------
# api/.env  — copy to .env and fill in. Never commit the real file.
# ---------------------------------------------------------------------------

# --- OpenAI (the only model provider in this project) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe

# --- Supabase: SERVICE ROLE key, server-side only. Bypasses RLS. ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- behaviour ---
# true  = every agent returns canned output, zero API spend (what stage 0 ships)
# false = real OpenAI calls
MOCK_AGENTS=true

# Comma-separated. Add each developer localhost and the Vercel domain.
ALLOWED_ORIGINS=http://localhost:3000

# --- email: OFF by default ---
ENABLE_EMAIL=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
# Gmail 16-character app password, NOT the account password. Requires 2FA.
SMTP_APP_PASSWORD=
SMTP_FROM_NAME=Sudhaar AI
# SAFETY VALVE: all mail goes here instead of the authority address.
# The seeded authority emails are invented placeholders. Keep this set.
EMAIL_OVERRIDE_TO=
