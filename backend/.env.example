# Get a key from https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key
# Pin a concrete model. gemini-flash-latest is an alias that 503s under load,
# and the 2.x flash models are retired. flash-lite is the default because the
# free tier meters requests per day PER MODEL and gemini-3.6-flash allows 20.
GEMINI_MODEL=gemini-3.5-flash-lite
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
CORS_ORIGINS=*
LOG_LEVEL=INFO
